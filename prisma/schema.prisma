datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EXPERT
  CLIENT
}

enum OrderStatus {
  SUBMITTED             // ۱. ثبت‌شده
  PENDING_REVIEW        // ۲. در انتظار بررسی
  REQUIRES_INFO         // ۳. نیازمند اطلاعات بیشتر
  QUOTED                // ۴. پیش‌فاکتور صادرشده
  AWAITING_CLIENT       // ۵. در انتظار تأیید مشتری
  AWAITING_PAYMENT      // ۶. در انتظار پرداخت
  PAID                  // ۷. پرداخت‌شده
  ASSIGNED              // ۸. ارجاع‌شده به کارشناس
  IN_PROGRESS           // ۹. در حال انجام
  READY_FOR_REVIEW      // ۱۰. آماده بررسی
  REVISION_REQUESTED    // ۱۱. نیازمند اصلاح
  READY_FOR_DELIVERY    // ۱۲. آماده تحویل
  COMPLETED             // ۱۳. تکمیل‌شده
  PAUSED                // ۱۴. متوقف‌شده
  CANCELLED             // ۱۵. لغوشده
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FileCategory {
  CLIENT_UPLOAD
  REFERENCE
  DELIVERABLE
  REVISION
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  fullName     String
  role         Role      @default(CLIENT)
  passwordHash String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientProfile   UserProfile?
  expertProfile   ExpertProfile?
  clientOrders    Order[]           @relation("ClientOrders")
  assignedOrders  Order[]           @relation("ExpertOrders")
  notifications   Notification[]
  messages        Message[]
  uploadedFiles   FileAsset[]
  tickets         SupportTicket[]
  ticketMessages  SupportMessage[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([email])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university  String?
  major       String?
  degree      String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpertProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicRank    String?
  specialties     String[]
  maxCapacity     Int      @default(5)
  activeCapacity  Int      @default(0)
  rating          Float    @default(5.0)
  completedCount  Int      @default(0)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  services    Service[]
}

model Service {
  id             String           @id @default(uuid())
  categoryId     String?
  category       ServiceCategory? @relation(fields: [categoryId], references: [id])
  slug           String           @unique
  title          String
  shortDesc      String
  fullDesc       String
  iconName       String
  basePrice      Decimal          @db.Decimal(12, 2)
  turnaroundDays Int              @default(7)
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  orders         Order[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([slug])
  @@index([isActive])
}

model Order {
  id             String        @id @default(uuid())
  trackingCode   String        @unique // e.g. QR-2026-000125
  title          String
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  clientId       String
  client         User          @relation("ClientOrders", fields: [clientId], references: [id])
  expertId       String?
  expert         User?         @relation("ExpertOrders", fields: [expertId], references: [id])
  status         OrderStatus   @default(SUBMITTED)
  priority       String        @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  fieldOfStudy   String
  degreeLevel    String
  workVolume     String?       // Pages / word count / data size
  language       String        @default("fa") // fa, en, bilingual
  targetDeadline DateTime?
  notes          String?
  agreedPrice    Decimal?      @db.Decimal(12, 2)
  currency       String        @default("TOMAN")
  isPaid         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  milestones     OrderMilestone[]
  statusHistory  OrderStatusHistory[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  messages       Message[]
  files          FileAsset[]
  deliverables   Deliverable[]
  revisions      RevisionRequest[]

  @@index([trackingCode])
  @@index([status])
  @@index([clientId])
  @@index([expertId])
}

model OrderMilestone {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  assignedTo  String?
  startedAt   DateTime?
  completedAt DateTime?

  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Quotation {
  id                String          @id @default(uuid())
  quotationNumber   String          @unique // e.g. QUOT-2026-0012
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount       Decimal         @db.Decimal(12, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(12, 2)
  payableAmount     Decimal         @db.Decimal(12, 2)
  expiresAt         DateTime
  deliveryDays      Int
  includedRevisions Int             @default(2)
  terms             String?
  status            QuotationStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items    QuotationItem[]
  invoices Invoice[]

  @@index([orderId])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  unitPrice   Decimal   @db.Decimal(12, 2)
  quantity    Int       @default(1)
  total       Decimal   @db.Decimal(12, 2)
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. INV-2026-0012
  quotationId   String?
  quotation     Quotation?    @relation(fields: [quotationId], references: [id])
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  payments      Payment[]

  @@index([orderId])
}

model Payment {
  id             String               @id @default(uuid())
  paymentCode    String               @unique // e.g. PAY-2026-0089
  orderId        String
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?             @relation(fields: [invoiceId], references: [id])
  amount         Decimal              @db.Decimal(12, 2)
  gateway        String               @default("DEMO") // DEMO, ZARINPAL, IDPAY
  status         PaymentStatus        @default(PENDING)
  referenceId    String?
  trackingNumber String?
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  transactions   PaymentTransaction[]

  @@index([orderId])
}

model PaymentTransaction {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action      String   // INITIATE, VERIFY, CALLBACK
  rawResponse String?
  success     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  senderRole Role
  content    String
  fileUrl    String?
  fileName   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model FileAsset {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User          @relation(fields: [uploaderId], references: [id])
  fileName    String
  fileType    String
  fileSize    Int           // bytes
  fileUrl     String
  category    FileCategory  @default(CLIENT_UPLOAD)
  isFinal     Boolean       @default(false)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  Deliverable Deliverable[]

  @@index([orderId])
}

model Deliverable {
  id          String            @id @default(uuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expertId    String
  title       String
  notes       String?
  version     Int               @default(1)
  fileAssetId String?
  fileAsset   FileAsset?        @relation(fields: [fileAssetId], references: [id])
  status      String            @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REVISION_NEEDED
  createdAt   DateTime          @default(now())
  revisions   RevisionRequest[]

  @@index([orderId])
}

model RevisionRequest {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id])
  clientId      String
  reason        String
  details       String
  status        String       @default("REQUESTED") // REQUESTED, IN_PROGRESS, RESOLVED
  createdAt     DateTime     @default(now())

  @@index([orderId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ORDER, PAYMENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SupportTicket {
  id           String           @id @default(uuid())
  ticketNumber String           @unique // TCK-2026-0045
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     String
  priority     TicketPriority   @default(MEDIUM)
  status       TicketStatus     @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User          @relation(fields: [senderId], references: [id])
  senderRole Role
  message    String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  group       String   @default("GENERAL") // GENERAL, BRANDING, NOTIFICATIONS, PAYMENTS
  description String?
  updatedAt   DateTime @updatedAt
}
