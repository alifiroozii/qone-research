# ==========================================
# Qone Research Environment Variables
# ==========================================

# Application Environment (development | production | test)
NODE_ENV=development

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future Database Connection (PostgreSQL)
# When ready for live DB, uncomment and set your connection string:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/qone_research?schema=public"

# Future Auth Secret (e.g. NextAuth or JWT)
# AUTH_SECRET="your-super-secret-random-key-32-chars-minimum"

# Future Payment Gateway Keys
# ZARINPAL_MERCHANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# IDPAY_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Future S3/Blob Storage (Vercel Blob or MinIO/AWS S3)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""
# S3_REGION=""
